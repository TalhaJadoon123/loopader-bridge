# ==========================================================================
# LOOPADER — ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in each value. Everything is free-tier.
# ==========================================================================

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Your public origin. Set to https://loopader.com in production.

NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# The Socket.io worker (Render) URL. Client connects here for live quotes + chart presence.

# --- Rust Trading Engine ---
ENGINE_SERVICE_URL=http://localhost:8080
# The fx-core matching engine REST API. Run: cd engine && cargo run

# --- Python Orchestrator ---
ORCHESTRATOR_URL=http://localhost:8000
# The FastAPI orchestrator (routing + engine client). Run: cd engine/orchestrator && python main.py
USE_ORCHESTRATOR=true
# Set to true to use orchestrator for routing decisions, false to call Rust engine directly

# --- Database: Neon Postgres (https://neon.tech, free tier, no card) ---
# Create a project, copy the POOLED connection string (hostname contains "-pooler").
# Neon free tier: use -pooler for runtime, non-pooler for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
# Non-pooled URL for Prisma migrations (hostname WITHOUT "-pooler"):
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Python orchestrator uses pooled URL with statement_cache_size=0:
ORCHESTRATOR_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Redis: Upstash (https://upstash.com, free tier) ---
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token
# Created in Upstash console under "REST API" tab.

# --- Auth: NextAuth (https://next-auth.js.org) ---
NEXTAUTH_URL=http://localhost:3000
# Must match your public URL in production.
NEXTAUTH_SECRET=generate_me_with_openssl_rand_base64_32
# Run: openssl rand -base64 32

# Access-token signing key (15 min access tokens, separate from NextAuth secret).
JWT_ACCESS_SECRET=another_long_random_string
# Run: openssl rand -hex 32

# --- WebAuthn / Passkeys (@simplewebauthn) ---
WEBAUTHN_RP_ID=localhost
# In production: your domain WITHOUT protocol, e.g. loopader.com
WEBAUTHN_RP_NAME=Loopader
WEBAUTHN_ORIGIN=http://localhost:3000
# In production: https://loopader.com

# --- Encryption at rest (AES-256-GCM key, 64 hex chars = 32 bytes) ---
ENCRYPTION_KEY=replace_with_64_hex_chars
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Cloudflare Turnstile (https://dash.cloudflare.com > Turnstile, free) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# --- OAuth: Sign in with Google (https://console.cloud.google.com/apis/credentials) ---
# Create an OAuth 2.0 Client ID (Web). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google  (and your production domain)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- OAuth: Sign in with Apple (https://developer.apple.com/account/resources/identifiers) ---
# Create a "Sign in with Apple" Services ID. Client ID = that Services ID.
# Client Secret = a signed JWT (see lib/auth/apple-secret.ts). Redirect URI:
#   http://localhost:3000/api/auth/callback/apple  (and your production domain)
APPLE_CLIENT_ID=com.loopader.app.service
APPLE_CLIENT_SECRET=your_signed_jwt
# Apple key details needed to generate the client secret JWT (store securely):
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Apple redirect origins (for native mobile sign-in):
APPLE_REDIRECT_URLS=["https://loopader.com/api/auth/callback/apple","com.loopader.app://"]

# --- HaveIBeenPwned (https://haveibeenpwned.com/API/v3, free, no key needed for k-anonymity range query) ---
HIBP_ENDPOINT=https://api.pwnedpasswords.com/range

# --- AI: Groq (https://console.groq.com, free tier) ---
GROQ_API_KEY=your_groq_api_key
# Get key from console.groq.com > API Keys.
GROQ_MODEL=openai/gpt-oss-120b

# --- AI fallback: Google Gemini (https://aistudio.google.com/apikey, free tier) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Market data providers (failover chain). Get keys from each dashboard. ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
# https://www.alphavantage.co/support/#api-key (500 req/day free)
FINNHUB_API_KEY=your_finnhub_key
# https://finnhub.io/register (60 req/min free)
TWELVE_DATA_API_KEY=your_twelve_data_key
# https://twelvedata.com/pricing (800 req/day free)

# --- News API (https://newsapi.org, free dev tier) ---
NEWSAPI_KEY=your_newsapi_key

# --- Email: Resend (https://resend.com, free 100/day) ---
RESEND_API_KEY=re_your_resend_key
# Test sender: "Loopader <onboarding@resend.dev>" — works without domain verification.
# For production, verify a domain at resend.com/domains and use your own from-address.
RESEND_FROM_EMAIL="Loopader <onboarding@resend.dev>"

# --- Push notifications: Firebase Cloud Messaging (https://console.firebase.google.com, free) ---
FIREBASE_PROJECT_ID=loopader
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@loopader.iam.gserviceaccount.com
NEXT_PUBLIC_FCM_VAPID_KEY=your_web_push_vapid_key

# --- Payments: Stripe (https://dashboard.stripe.com/test/apikeys, test mode) ---
STRIPE_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# --- Payments: NOWPayments (https://nowpayments.io, free crypto) ---
NOWPAYMENTS_API_KEY=your_nowpayments_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret
NOWPAYMENTS_SANDBOX=true

# --- Payments: Binance Pay (https://bpay.binance.com) ---
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_WEBHOOK_SECRET=

# --- Webhook Test Mode (for local testing only - NEVER enable in production) ---
WEBHOOK_TEST_MODE=false

# --- Payments: Card Processor (Stub / Stripe / High-Risk PSP) ---
CARD_PROCESSOR=STUB
CARD_API_KEY=
CARD_API_URL=
CARD_WEBHOOK_SECRET=

# --- Payments: Wire Transfer ---
WIRE_BANK_NAME=
WIRE_BANK_ACCOUNT=
WIRE_BANK_SWIFT=
WIRE_BANK_IBAN=

# --- Analytics: PostHog (https://posthog.com, free 1M events/mo) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Error tracking: Sentry (https://sentry.io, free tier) ---
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# --- Mobile push device tokens are stored per-user; FCM above covers delivery. ---

# --- Cron protection (optional shared secret for Vercel cron endpoints) ---
CRON_SECRET=your_cron_secret

# --- Internal API key for orchestrator -> Next.js communication ---
INTERNAL_API_KEY=generate_with_openssl_rand_hex_32

# --- Rate limiting (Redis-backed via Upstash; values in lib/security/rate-limit.ts) ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_TRADE_MAX=60
RATE_LIMIT_TRADE_WINDOW_SEC=60
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SEC=60

# --- Referral credit (USD) ---
REFERRAL_BONUS_USD=10

# --- MT5: MetaApi.cloud (https://app.metaapi.cloud, free tier) ---
# Real MT5 account trading: users connect their broker MT5 accounts
METAAPI_TOKEN=your_metaapi_token

# --- Seed: admin password (bcrypt hash, NOT plaintext) ---
# Generate: node -e "require('bcryptjs').hash(process.argv[1],12).then(h=>console.log(h))" '<password>'
ADMIN_PASSWORD_HASH=

# ==========================================================================
# PHASE 3: DUAL-ACCOUNT PLATFORM + LP CONFIGURATION
# ==========================================================================

# --- LP Configuration (Liquidity Provider) ---
LP_ENABLED=false
LP_PROVIDER=STUB
LP_API_KEY=
LP_API_URL=
LP_ACCOUNT_ID=

# --- Demo Account ---
DEMO_STARTING_BALANCE=10000